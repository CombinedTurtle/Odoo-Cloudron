user root;
worker_processes auto;
pid /run/nginx.pid;
error_log /app/data/nginx_error.log warn;

events {
    worker_connections 1024;
}

http {
    access_log /app/data/nginx_access.log;

    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    sendfile on;
    keepalive_timeout 65;

    client_body_temp_path /tmp/nginx_client_body;
    proxy_temp_path /tmp/nginx_proxy;
    fastcgi_temp_path /tmp/nginx_fastcgi;
    uwsgi_temp_path /tmp/nginx_uwsgi;
    scgi_temp_path /tmp/nginx_scgi;

    # Map for WebSocket upgrade support (used by Odoo Discuss real-time)
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    upstream odoohttp {
        server 127.0.0.1:8070;
    }

    upstream odoolongpoll {
        server 127.0.0.1:8072;
    }

    server {
        listen 8069;
        server_name _;

        # Allow large file uploads (attachments, etc.)
        client_max_body_size 100m;

        # Odoo Discuss long-polling endpoint (bus module)
        # Extended timeouts and no buffering are critical:
        # - Odoo holds these connections open for ~55s waiting for notifications
        # - Buffering would prevent real-time delivery
        # - Cloudron's outer proxy would otherwise time out these connections
        location /longpolling {
            proxy_pass http://odoolongpoll;
            proxy_http_version 1.1;
            proxy_read_timeout 300s;
            proxy_connect_timeout 60s;
            proxy_send_timeout 300s;
            proxy_buffering off;
            proxy_cache off;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }

        # Odoo real-time WebSocket endpoint (bus module)
        # Odoo 17+ uses WebSockets for real-time (Discuss, live chat). This must
        # be proxied to the gevent worker (odoolongpoll) with upgrade headers,
        # otherwise the browser's /websocket connection hits the main workers
        # and fails with 400 -> "real time connection lost".
        location /websocket {
            proxy_pass http://odoolongpoll;
            proxy_http_version 1.1;
            proxy_read_timeout 300s;
            proxy_connect_timeout 60s;
            proxy_send_timeout 300s;
            proxy_buffering off;
            proxy_cache off;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }

        # Regular HTTP traffic
        location / {
            proxy_pass http://odoohttp;
            proxy_http_version 1.1;
            proxy_read_timeout 60s;
            proxy_connect_timeout 10s;
            proxy_send_timeout 60s;
            proxy_buffers 8 16k;
            proxy_buffer_size 16k;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }
    }
}
